{
  "firstWave": [
    "app.route",
    "app.impl.auth",
    "app.impl.run_export",
    "app.impl.workspace",
    "app.service.statement"
  ],
  "layers": [
    {
      "name": "route",
      "match": [
        "app.route"
      ],
      "allow": [
        "app.route",
        "app.impl"
      ]
    },
    {
      "name": "implementation",
      "match": [
        "app.impl"
      ],
      "allow": [
        "app.impl",
        "app.config",
        "app.service",
        "app.db",
        "app.main_constant",
        "app.main_util",
        "app.setting"
      ]
    },
    {
      "name": "service",
      "match": [
        "app.service"
      ],
      "allow": [
        "app.service",
        "app.config",
        "app.db",
        "app.main_constant",
        "app.main_util",
        "app.setting"
      ]
    }
  ],
  "namingPolicy": {
    "scopePrefixes": [
      "app.impl.auth",
      "app.impl.run_export",
      "app.impl.workspace",
      "app.service.statement",
      "app.service.verification"
    ]
  }
}
