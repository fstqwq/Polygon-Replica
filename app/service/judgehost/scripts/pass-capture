#!/bin/sh
# Best-effort multi-pass artifact capture. A failure here must never alter the
# validator/interactor exit status.

BUNDLE_MAX_BYTES={{BUNDLE_MAX_BYTES}}

is_regular_file() {
  [ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ]
}

copy_required() {
  SOURCE_FILE="$1"
  TARGET_FILE="$2"
  is_regular_file "$SOURCE_FILE" || return 1
  mkdir -p "$(dirname "$TARGET_FILE")" 2>/dev/null || return 1
  cp "$SOURCE_FILE" "$TARGET_FILE" 2>/dev/null
}

copy_optional_empty() {
  SOURCE_FILE="$1"
  TARGET_FILE="$2"
  mkdir -p "$(dirname "$TARGET_FILE")" 2>/dev/null || return 1
  if [ -e "$SOURCE_FILE" ] || [ -L "$SOURCE_FILE" ]; then
    copy_required "$SOURCE_FILE" "$TARGET_FILE"
  else
    : >"$TARGET_FILE"
  fi
}

validate_pass_layout() {
  CURRENT_DIR=$(pwd -P 2>/dev/null) || return 1
  FINAL_NUMBER=${CURRENT_DIR##*/}
  case "$FINAL_NUMBER" in
    [1-9]|[1-9][0-9]*) ;;
    *) return 1 ;;
  esac
  TESTCASE_DIR=${CURRENT_DIR%/*}
  [ "$TESTCASE_DIR" != "$CURRENT_DIR" ] || return 1

  PASS_NUMBER=1
  while [ "$PASS_NUMBER" -lt "$FINAL_NUMBER" ]; do
    PASS_DIR="$TESTCASE_DIR/$PASS_NUMBER"
    [ -d "$PASS_DIR" ] && [ ! -L "$PASS_DIR" ] || return 1
    RESOLVED_PASS_DIR=$(CDPATH= cd -- "$PASS_DIR" 2>/dev/null && pwd -P) || return 1
    [ "$RESOLVED_PASS_DIR" = "$PASS_DIR" ] || return 1
    PASS_NUMBER=$((PASS_NUMBER + 1))
  done
}

validate_historical_metadata() {
  PASS_NUMBER=1
  while [ "$PASS_NUMBER" -lt "$FINAL_NUMBER" ]; do
    PASS_DIR="$TESTCASE_DIR/$PASS_NUMBER"
    is_regular_file "$PASS_DIR/program.meta" || return 1
    is_regular_file "$PASS_DIR/compare.meta" || return 1
    PASS_NUMBER=$((PASS_NUMBER + 1))
  done
}

populate_historical_passes() {
  BUILD_DIR="$1"
  PROFILE="$2"
  PASS_NUMBER=1
  while [ "$PASS_NUMBER" -lt "$FINAL_NUMBER" ]; do
    PASS_DIR="$TESTCASE_DIR/$PASS_NUMBER"
    TARGET_DIR="$BUILD_DIR/passes/$PASS_NUMBER"
    mkdir -p "$TARGET_DIR" 2>/dev/null || return 1
    if [ "$PROFILE" = complete ]; then
      copy_required "$PASS_DIR/testdata.in" "$TARGET_DIR/input" || return 1
      copy_required "$PASS_DIR/program.out" "$TARGET_DIR/program.out" || return 1
      copy_required "$PASS_DIR/program.err" "$TARGET_DIR/program.err" || return 1
      copy_required "$PASS_DIR/system.out" "$TARGET_DIR/system.out" || return 1
      copy_required "$PASS_DIR/program.meta" "$TARGET_DIR/program.meta" || return 1
      copy_required "$PASS_DIR/compare.meta" "$TARGET_DIR/compare.meta" || return 1
      copy_required "$PASS_DIR/feedback/judgemessage.txt" "$TARGET_DIR/judgemessage.txt" || return 1
      copy_optional_empty "$PASS_DIR/feedback/teammessage.txt" "$TARGET_DIR/teammessage.txt" || return 1
    elif [ "$PROFILE" = metadata-input-only ]; then
      copy_required "$PASS_DIR/testdata.in" "$TARGET_DIR/input" || return 1
      copy_required "$PASS_DIR/program.meta" "$TARGET_DIR/program.meta" || return 1
      copy_required "$PASS_DIR/compare.meta" "$TARGET_DIR/compare.meta" || return 1
    else
      copy_required "$PASS_DIR/program.meta" "$TARGET_DIR/program.meta" || return 1
      copy_required "$PASS_DIR/compare.meta" "$TARGET_DIR/compare.meta" || return 1
    fi
    PASS_NUMBER=$((PASS_NUMBER + 1))
  done
}

populate_final_supplement() {
  BUILD_DIR="$1"
  TARGET_DIR="$BUILD_DIR/passes/$FINAL_NUMBER"
  mkdir -p "$TARGET_DIR" 2>/dev/null || return 1
  copy_required "$CURRENT_DIR/testdata.in" "$TARGET_DIR/input" || return 1
  copy_optional_empty "$FEEDBACK_DIR/teammessage.txt" "$TARGET_DIR/teammessage.txt"
}

create_bundle() {
  BUILD_DIR="$1"
  BUNDLE_FILE="$2"
  PROFILE="$3"
  set -- .polygon-pass-bundle final-pass-number
  PASS_NUMBER=1
  while [ "$PASS_NUMBER" -le "$FINAL_NUMBER" ]; do
    if [ "$PASS_NUMBER" -eq "$FINAL_NUMBER" ]; then
      set -- "$@" "passes/$PASS_NUMBER/input" "passes/$PASS_NUMBER/teammessage.txt"
    elif [ "$PROFILE" = complete ]; then
      set -- "$@" \
        "passes/$PASS_NUMBER/input" "passes/$PASS_NUMBER/program.out" \
        "passes/$PASS_NUMBER/program.err" "passes/$PASS_NUMBER/system.out" \
        "passes/$PASS_NUMBER/program.meta" "passes/$PASS_NUMBER/compare.meta" \
        "passes/$PASS_NUMBER/judgemessage.txt" "passes/$PASS_NUMBER/teammessage.txt"
    elif [ "$PROFILE" = metadata-input-only ]; then
      set -- "$@" "passes/$PASS_NUMBER/input" \
        "passes/$PASS_NUMBER/program.meta" "passes/$PASS_NUMBER/compare.meta"
    else
      set -- "$@" "passes/$PASS_NUMBER/program.meta" "passes/$PASS_NUMBER/compare.meta"
    fi
    PASS_NUMBER=$((PASS_NUMBER + 1))
  done
  tar -cf "$BUNDLE_FILE" -C "$BUILD_DIR" "$@" 2>/dev/null
}

write_bundle() {
  validate_pass_layout || return 1
  validate_historical_metadata || return 1

  PROFILE=complete
  while :; do
    BUILD_DIR="$FEEDBACK_DIR/.polygon-pass-build.$$.$PROFILE"
    BUNDLE_FILE="$FEEDBACK_DIR/.polygon-pass-bundle.$$.$PROFILE"
    rm -rf "$BUILD_DIR" 2>/dev/null || true
    rm -f "$BUNDLE_FILE" 2>/dev/null || true
    mkdir -p "$BUILD_DIR" 2>/dev/null || return 1
    if ! : >"$BUILD_DIR/.polygon-pass-bundle" \
      || ! printf '%s\n' "$FINAL_NUMBER" >"$BUILD_DIR/final-pass-number"; then
      rm -rf "$BUILD_DIR" 2>/dev/null || true
      return 1
    fi

    if populate_historical_passes "$BUILD_DIR" "$PROFILE" \
      && populate_final_supplement "$BUILD_DIR" \
      && create_bundle "$BUILD_DIR" "$BUNDLE_FILE" "$PROFILE"; then
      BUNDLE_SIZE=$(wc -c <"$BUNDLE_FILE" 2>/dev/null | tr -d '[:space:]') || BUNDLE_SIZE=0
      case "$BUNDLE_SIZE" in
        *[!0-9]*) BUNDLE_SIZE=0 ;;
      esac
      if [ "$BUNDLE_SIZE" -gt 0 ] && [ "$BUNDLE_SIZE" -le "$BUNDLE_MAX_BYTES" ]; then
        if mv -f "$BUNDLE_FILE" "$FEEDBACK_DIR/teammessage.txt" 2>/dev/null; then
          rm -rf "$BUILD_DIR" 2>/dev/null || true
          return 0
        fi
        rm -f "$BUNDLE_FILE" 2>/dev/null || true
        rm -rf "$BUILD_DIR" 2>/dev/null || true
        return 1
      fi
    fi
    rm -f "$BUNDLE_FILE" 2>/dev/null || true
    rm -rf "$BUILD_DIR" 2>/dev/null || true

    if [ "$PROFILE" = complete ]; then
      PROFILE=metadata-input-only
    elif [ "$PROFILE" = metadata-input-only ]; then
      PROFILE=metadata-only
    else
      return 1
    fi
  done
}

polygon_capture_pass() {
  FEEDBACK_ARG="$2"
  EXIT_STATUS="$3"
  CURRENT_DIR=$(pwd -P 2>/dev/null) || return 0
  EXPECTED_FEEDBACK_DIR="$CURRENT_DIR/feedback"
  [ -d "$EXPECTED_FEEDBACK_DIR" ] && [ ! -L "$EXPECTED_FEEDBACK_DIR" ] || return 0
  FEEDBACK_DIR=$(CDPATH= cd -- "$FEEDBACK_ARG" 2>/dev/null && pwd -P) || return 0
  [ "$FEEDBACK_DIR" = "$EXPECTED_FEEDBACK_DIR" ] || return 0

  if [ "$EXIT_STATUS" -eq 42 ] && [ -f "$FEEDBACK_DIR/nextpass.in" ]; then
    return 0
  fi
  write_bundle || true
  return 0
}

polygon_capture_pass "$@"
exit 0
