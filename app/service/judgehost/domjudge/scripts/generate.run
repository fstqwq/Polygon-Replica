#!/bin/sh
set -e
TESTIN="$1"
PROGOUT="$2"
shift 2

if [ "$#" -eq 0 ]; then
  echo "missing submission command" >&2
  exit 43
fi

CMD_PAYLOAD=""
if [ -r "$TESTIN" ] && [ ! -d "$TESTIN" ]; then
  CMD_PAYLOAD="$(tr -d '\r' <"$TESTIN" | sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' | head -n 1)"
fi

if [ -z "$CMD_PAYLOAD" ]; then
  echo "missing generate command payload" >&2
  exit 43
fi

ARGS_PAYLOAD="$(printf '%s' "$CMD_PAYLOAD" | sed -e 's/^"\$SUBMISSION_BIN"[[:space:]]*//')"
if [ "$ARGS_PAYLOAD" = "$CMD_PAYLOAD" ]; then
  ARGS_PAYLOAD="$(printf '%s' "$CMD_PAYLOAD" | sed -e 's/^\$SUBMISSION_BIN[[:space:]]*//')"
fi

REPEAT_OUT="${PROGOUT}.repeat.$$"
REPEAT_MARKER="${PROGOUT}.repeatability-failed"
trap 'rm -f "$REPEAT_OUT"' EXIT
rm -f "$REPEAT_OUT" "$REPEAT_MARKER"

run_generator() {
  output="$1"
  shift
  if [ -n "$ARGS_PAYLOAD" ]; then
    # Payload is shell-quoted by backend. Preserve the original command vector
    # (`sudo -n runguard ... -- program`) and append payload args after it.
    sh -c "exec \"\$@\" $ARGS_PAYLOAD" sh "$@" </dev/null >"$output"
    return $?
  fi
  "$@" </dev/null >"$output"
}

set +e
run_generator "$PROGOUT" "$@"
FIRST_RC=$?
run_generator "$REPEAT_OUT" "$@"
SECOND_RC=$?
set -e

if [ "$FIRST_RC" -ne 0 ] || [ "$SECOND_RC" -ne 0 ]; then
  echo "generator execution failed" >&2
  if [ "$FIRST_RC" -ne 0 ]; then
    exit "$FIRST_RC"
  fi
  exit "$SECOND_RC"
fi

set +e
cmp -s "$PROGOUT" "$REPEAT_OUT"
CMP_RC=$?
set -e
if [ "$CMP_RC" -eq 0 ]; then
  exit 0
fi
if [ "$CMP_RC" -eq 1 ]; then
  : >"$REPEAT_MARKER"
  exit 0
fi

echo "unable to compare generator outputs" >&2
exit 43
